# ==========================================
# Archive Micro-Story Facebook Page - Environment Variables
# ==========================================

# 1. Google Gemini API Key (Required for drafting, judging, OCR extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Meta / Facebook Graph API Credentials (Required for automated posting)
# See Phase 2 of Plan: Business App + System User Token
META_PAGE_ID=your_facebook_page_id_here
META_PAGE_ACCESS_TOKEN=your_never_expiring_page_access_token_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# 3. Telegram Bot Credentials (Required for phone-based Approve / Rewrite / Reject)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_personal_telegram_numeric_chat_id

# 4. Optional / Advanced
# Public URL where assets can be fetched by Facebook Graph API (e.g. Cloudflare R2 / S3 / Ngrok)
ASSETS_BASE_URL=
